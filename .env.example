# СКОПИРУЙТЕ В .env И ЗАПОЛНИТЕ. Не отправляйте заполненный файл кому-либо.
PORT=3000
JARVIS_ACCESS_CODE=SET_A_LONG_PRIVATE_PIN_HERE
# URL вебхука Dialog Stable из n8n, не REST и не Voice
N8N_DIALOG_URL=https://YOUR-SUBDOMAIN.app.n8n.cloud/webhook/jarvis-dialog
# Название и значение заголовка из credential Header Auth в n8n
N8N_AUTH_HEADER_NAME=X-JARVIS-SECRET
N8N_AUTH_HEADER_VALUE=SET_THIS_TO_YOUR_N8N_HEADER_AUTH_VALUE
# Ключ именно OpenAI API. Используется только для распознавания речи.
OPENAI_API_KEY=SET_OPENAI_API_KEY
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# ElevenLabs только озвучивает ответы. Голос из существующего workflow.
ELEVENLABS_API_KEY=SET_ELEVENLABS_KEY
ELEVENLABS_VOICE_ID=SET_VOICE_ID_FROM_CURRENT_WORKFLOW
ELEVENLABS_MODEL_ID=eleven_v4
# Параметры будущей универсальности (пока используются только как метаданные демо)
JARVIS_TENANT_ID=jarvis-demo
JARVIS_PROVIDER=openai
# Локальная проверка интерфейса с макетными ответами — не запрашивает OpenAI/n8n/ElevenLabs
DEMO_MODE=false
